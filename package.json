{
  "name": "insightra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Insightra — E-commerce Business Intelligence dashboard (Nuxt 3 + TypeScript + Sass portfolio project)",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "start": "node .output/server/index.mjs"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.0",
    "echarts": "^6.0.0",
    "nuxt": "^3.21.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vuedraggable": "^4.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
